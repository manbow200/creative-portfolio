<%- include('../partials/header') %>
<%- include('../partials/nav', { activePage: 'services' }) %>

<section class="about-hero animate-on-scroll" style="padding-bottom: 60px;">
  <div class="container" style="text-align: center;">
    <h3 style="color: var(--accent-primary); text-transform: uppercase; letter-spacing: 0.1em; font-size: 1.1rem; margin-bottom: 15px;">Professional Offerings</h3>
    <h1 style="font-size: 3rem; margin-bottom: 20px;">Services & Expertise</h1>
    <p style="max-width: 600px; margin: 0 auto; color: var(--text-secondary);">
      I deliver end-to-end digital solutions spanning code, designs, hardware troubleshooting, and social campaigns to accelerate your personal brand or business.
    </p>
  </div>
</section>

<section class="services-section bg-glass" style="border-radius: 0; padding: 60px 0 100px;">
  <div class="container" style="display: flex; flex-direction: column; gap: 60px;">
    
    <!-- 1. GRAPHIC DESIGN -->
    <div class="about-grid animate-on-scroll">
      <div class="service-details bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <div class="service-icon" style="background: var(--gradient-glow); color: #fff;"><i class="bi bi-palette"></i></div>
        <h2 style="font-size: 2rem; margin-bottom: 15px;">Graphic Design</h2>
        <p style="color: var(--text-secondary); margin-bottom: 25px; line-height: 1.7;">
          Stand out with visual identities built for impact. I conceptualize brand guides, logos, vectors, and marketing flyers that convey authority.
        </p>
        <ul style="list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Logo Design & Guidelines</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Corporate Branding Assets</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Posters & Business Cards</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> High-fidelity Marketing Flyers</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Social Media Graphics grids</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Vector Assets Creation</li>
        </ul>
      </div>
      <div style="display: flex; flex-direction: column; justify-content: center;" class="bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--accent-primary);">Brand Impact</h3>
        <p style="color: var(--text-secondary); line-height: 1.8;">
          Your visuals are your first handshake with prospective clients. I utilize high-performance vector graphics and modern HSL palette harmonies to construct brand packages that remain memorable, recognizable, and scalable across web formats and large-scale prints.
        </p>
      </div>
    </div>

    <!-- 2. WEB DEVELOPMENT -->
    <div class="about-grid animate-on-scroll">
      <div style="display: flex; flex-direction: column; justify-content: center;" class="bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--accent-cyan);">Robust Integrations</h3>
        <p style="color: var(--text-secondary); line-height: 1.8;">
          Speed, responsiveness, security, and search engine discoverability are the cornerstones of successful modern sites. I build clean, server-side optimized code with database integrations to serve secure content instantaneously to visitors.
        </p>
      </div>
      <div class="service-details bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <div class="service-icon" style="background: var(--gradient-glow); color: #fff;"><i class="bi bi-code-slash"></i></div>
        <h2 style="font-size: 2rem; margin-bottom: 15px;">Web Design & Development</h2>
        <p style="color: var(--text-secondary); margin-bottom: 25px; line-height: 1.7;">
          High-performance corporate sites, administrative management dashboards, and custom e-commerce applications built on robust code.
        </p>
        <ul style="list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-primary); margin-right: 10px;"></i> Professional Business Sites</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-primary); margin-right: 10px;"></i> Custom E-commerce Portals</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-primary); margin-right: 10px;"></i> RESTful APIs & Backends</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-primary); margin-right: 10px;"></i> Database Design (MySQL/SQLite)</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-primary); margin-right: 10px;"></i> Admin Dashboard & CMS</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-primary); margin-right: 10px;"></i> SEO Friendly Layouts</li>
        </ul>
      </div>
    </div>

    <!-- 3. UI/UX DESIGN -->
    <div class="about-grid animate-on-scroll">
      <div class="service-details bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <div class="service-icon" style="background: var(--gradient-glow); color: #fff;"><i class="bi bi-vector-pen"></i></div>
        <h2 style="font-size: 2rem; margin-bottom: 15px;">UI/UX Design</h2>
        <p style="color: var(--text-secondary); margin-bottom: 25px; line-height: 1.7;">
          Interface prototypes and user flows optimized for conversion. I focus on customer journey maps, color hierarchy, and grid layouts.
        </p>
        <ul style="list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Website UI Prototypes</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Mobile App UI Design</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Interactive Wireframes</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Figma Component Libraries</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> Clickable Prototypes</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-cyan); margin-right: 10px;"></i> User Journey Maps</li>
        </ul>
      </div>
      <div style="display: flex; flex-direction: column; justify-content: center;" class="bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--accent-primary);">User Centered Design</h3>
        <p style="color: var(--text-secondary); line-height: 1.8;">
          A stunning UI is useless without optimized user flows. I create clickable interactive wireframes in Figma to mock up exact flows, ensuring your customers locate services, checkouts, or calls to action with minimal friction and maximum delight.
        </p>
      </div>
    </div>

    <!-- 4. IT SUPPORT & REPAIR -->
    <div class="about-grid animate-on-scroll">
      <div style="display: flex; flex-direction: column; justify-content: center;" class="bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--accent-cyan);">Hardware Diagnostic</h3>
        <p style="color: var(--text-secondary); line-height: 1.8;">
          Workstations must run cool and clean to prevent hardware throttling during intense tasks. I offer pro-grade cleaning, thermal repasting, network configuration, and system optimizations to keep hardware performing like brand new.
        </p>
      </div>
      <div class="service-details bg-glass" style="padding: 40px; border-radius: var(--border-radius-lg);">
        <div class="service-icon" style="background: var(--gradient-glow); color: #fff;"><i class="bi bi-cpu"></i></div>
        <h2 style="font-size: 2rem; margin-bottom: 15px;">Computer Repair & IT Support</h2>
        <p style="color: var(--text-secondary); margin-bottom: 25px; line-height: 1.7;">
          Diagnostics, hardware maintenance, OS configuration, component upgrades, and software deployments.
        </p>
        <ul style="list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-secondary); margin-right: 10px;"></i> Windows/Linux Fresh Installs</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-secondary); margin-right: 10px;"></i> Hardware Component Upgrades</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-secondary); margin-right: 10px;"></i> Thermal Pasting & Dust Cleaning</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-secondary); margin-right: 10px;"></i> System Bottleneck Diagnosis</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-secondary); margin-right: 10px;"></i> Pro-grade Software Configs</li>
          <li><i class="bi bi-check-circle-fill" style="color: var(--accent-secondary); margin-right: 10px;"></i> Network Troubleshooting</li>
        </ul>
      </div>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
