<%- include('../partials/header') %>
<%- include('../partials/nav', { activePage: 'portfolio' }) %>

<section class="project-detail-section">
  <div class="container">
    
    <!-- Breadcrumb back link -->
    <a href="/portfolio" class="project-link" style="margin-bottom: 30px; display: inline-flex; align-items: center; gap: 8px;">
      <i class="bi bi-chevron-left"></i> Back to Portfolio
    </a>

    <!-- Title and Metadata Grid -->
    <div class="project-header-grid animate-on-scroll">
      <!-- Media Player / Image Frame -->
      <div class="project-gallery-main bg-glass">
        <% if (project.video) { %>
          <div class="video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; background: #000;">
            <% if (project.video.includes('youtube.com') || project.video.includes('youtu.be') || project.video.includes('embed')) { %>
              <!-- YouTube Video Player -->
              <iframe src="<%= project.video %>" frameborder="0" allowfullscreen style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
            <% } else { %>
              <!-- Uploaded MP4 Video Player -->
              <video src="<%= project.video %>" controls style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain;"></video>
            <% } %>
          </div>
        <% } else { %>
          <img src="<%= project.image %>" alt="<%= project.title %>" style="width: 100%; max-height: 480px; object-fit: cover;" onerror="this.src='/images/placeholder.jpg'">
        <% } %>
      </div>

      <!-- Metadata Box -->
      <div class="project-meta-box bg-glass">
        <span class="project-overlay" style="position: static; display: inline-block; margin-bottom: 20px;"><%= project.category %></span>
        <h1 style="font-size: 2.25rem; margin-bottom: 25px;"><%= project.title %></h1>
        
        <div class="meta-item">
          <div class="meta-label"><%= __('tech_used') %></div>
          <div class="meta-val" style="color: var(--accent-cyan); font-weight: 600;"><%= project.technologies %></div>
        </div>

        <% if (project.client_info) { %>
          <div class="meta-item">
            <div class="meta-label"><%= __('client') %></div>
            <div class="meta-val"><%= project.client_info %></div>
          </div>
        <% } %>

        <% if (project.completion_date) { %>
          <div class="meta-item">
            <div class="meta-label"><%= __('date') %></div>
            <div class="meta-val"><%= new Date(project.completion_date).toLocaleDateString(undefined, {year: 'numeric', month: 'long', day: 'numeric'}) %></div>
          </div>
        <% } %>

        <div class="meta-item">
          <div class="meta-label">Total Views</div>
          <div class="meta-val"><i class="bi bi-eye"></i> <%= project.views %> visits</div>
        </div>

        <div class="meta-links">
          <% if (project.website_link) { %>
            <a href="<%= project.website_link %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <i class="bi bi-globe"></i> <%= __('website_link') %>
            </a>
          <% } %>
          <% if (project.github_link) { %>
            <a href="<%= project.github_link %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <i class="bi bi-github"></i> <%= __('github_link') %>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Description Block -->
    <div class="bg-glass animate-on-scroll" style="padding: 40px; border-radius: var(--border-radius-md); margin-bottom: 50px;">
      <h2 style="font-size: 1.5rem; margin-bottom: 20px; color: var(--text-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">Project Summary</h2>
      <p style="font-size: 1.1rem; line-height: 1.8; color: var(--text-secondary);"><%= project.description %></p>
    </div>

    <!-- Challenges & Solutions Grid -->
    <div class="project-body-grid animate-on-scroll">
      <% if (project.challenges) { %>
        <div class="detail-block bg-glass">
          <h3><i class="bi bi-exclamation-triangle"></i> <%= __('problem') %></h3>
          <p style="line-height: 1.7; color: var(--text-secondary);"><%= project.challenges %></p>
        </div>
      <% } %>

      <% if (project.solutions) { %>
        <div class="detail-block bg-glass">
          <h3><i class="bi bi-check-circle"></i> <%= __('solution') %></h3>
          <p style="line-height: 1.7; color: var(--text-secondary);"><%= project.solutions %></p>
        </div>
      <% } %>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
