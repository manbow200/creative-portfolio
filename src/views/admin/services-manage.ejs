<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'services', title: 'Services Management' }) %>

<!-- Add Service Panel -->
<div class="form-card">
  <div class="form-card-title">
    <i class="bi bi-plus-circle"></i> Add New Service
  </div>
  
  <form action="/admin/services/add" method="POST">
    <div class="form-grid-2">
      <div class="admin-form-group">
        <label for="title">Service Title *</label>
        <input type="text" id="title" name="title" class="admin-input" required placeholder="Web Development">
      </div>
      <div class="admin-form-group">
        <label for="icon">Icon Class (Bootstrap Icons) *</label>
        <input type="text" id="icon" name="icon" class="admin-input" required placeholder="bi-code-slash">
        <span style="font-size: 0.75rem; color: var(--text-admin-muted); margin-top: 5px; display: block;">Use classes from Bootstrap Icons (e.g., bi-palette, bi-code-slash, bi-cpu, bi-megaphone, bi-vector-pen)</span>
      </div>
    </div>

    <div class="admin-form-group">
      <label for="description">Service Description *</label>
      <textarea id="description" name="description" class="admin-input" required placeholder="Briefly describe what this service includes..."></textarea>
    </div>

    <button type="submit" class="admin-btn" style="max-width: 200px;">
      <i class="bi bi-check-circle"></i> Add Service
    </button>
  </form>
</div>

<!-- Services list table -->
<div class="data-box">
  <div class="data-box-header">
    <h3>Active Services</h3>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Icon</th>
          <th>Service Title</th>
          <th>Description Summary</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (services.length > 0) { %>
          <% services.forEach(s => { %>
            <tr>
              <td>
                <div style="width: 35px; height: 35px; border-radius: 4px; background: rgba(99,102,241,0.1); display: flex; align-items: center; justify-content: center; color: var(--color-primary); font-size: 1.25rem;">
                  <i class="bi <%= s.icon %>"></i>
                </div>
              </td>
              <td><strong><%= s.title %></strong></td>
              <td style="font-size: 0.85rem; color: var(--text-admin-secondary); max-width: 400px; overflow: hidden; text-overflow: ellipsis;"><%= s.description %></td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 8px;">
                  <button class="admin-btn" style="padding: 6px 12px; background: var(--color-warning); font-size: 0.8rem;"
                    onclick="openEditServiceModal(<%= JSON.stringify(s) %>)">
                    <i class="bi bi-pencil-square"></i> Edit
                  </button>
                  
                  <form action="/admin/services/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this service?');">
                    <button type="submit" class="admin-btn" style="padding: 6px 12px; background: var(--color-danger); font-size: 0.8rem;">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align: center; color: var(--text-admin-muted); padding: 40px;">No services added yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Edit Service Modal -->
<div class="form-card" id="edit-service-modal" style="display: none; position: fixed; top: 15%; left: 5%; right: 5%; width: 90%; z-index: 1000; box-shadow: 0 10px 50px rgba(0,0,0,0.8); border-color: var(--color-warning);">
  <div class="form-card-title" style="display: flex; justify-content: space-between; align-items: center;">
    <span><i class="bi bi-pencil-square"></i> Modify Service</span>
    <button onclick="closeModal('edit-service-modal')" class="admin-btn" style="max-width: 50px; background: var(--bg-admin-elevated); padding: 5px;"><i class="bi bi-x-lg"></i></button>
  </div>
  
  <form action="" method="POST">
    <div class="form-grid-2">
      <div class="admin-form-group">
        <label for="edit-title">Service Title *</label>
        <input type="text" id="edit-title" name="title" class="admin-input" required>
      </div>
      <div class="admin-form-group">
        <label for="edit-icon">Icon Class (Bootstrap Icons) *</label>
        <input type="text" id="edit-icon" name="icon" class="admin-input" required>
      </div>
    </div>

    <div class="admin-form-group">
      <label for="edit-description">Service Description *</label>
      <textarea id="edit-description" name="description" class="admin-input" required></textarea>
    </div>

    <div style="display: flex; gap: 15px;">
      <button type="submit" class="admin-btn" style="max-width: 200px; background: var(--color-warning);">
        <i class="bi bi-save"></i> Save Service Changes
      </button>
      <button type="button" class="admin-btn" style="max-width: 150px; background: var(--bg-admin-elevated);" onclick="closeModal('edit-service-modal')">
        Cancel
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
