<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'testimonials', title: 'Testimonials Management' }) %>

<!-- Add Testimonial Panel -->
<div class="form-card">
  <div class="form-card-title">
    <i class="bi bi-chat-square-quote"></i> Add Client Review / Testimonial
  </div>
  
  <form action="/admin/testimonials/add" method="POST" enctype="multipart/form-data">
    <div class="form-grid-2">
      <div class="admin-form-group">
        <label for="name">Client Full Name *</label>
        <input type="text" id="name" name="name" class="admin-input" required placeholder="John Doe">
      </div>
      <div class="admin-form-group">
        <label for="company">Company / Role</label>
        <input type="text" id="company" name="company" class="admin-input" placeholder="CEO, TechCorp TZ">
      </div>
    </div>

    <div class="admin-form-group">
      <label for="image">Client Avatar Image</label>
      <input type="file" id="image" name="image" class="admin-input" accept="image/*">
    </div>

    <div class="admin-form-group">
      <label for="message">Testimonial Message *</label>
      <textarea id="message" name="message" class="admin-input" required placeholder="Write what this client said about your work..."></textarea>
    </div>

    <button type="submit" class="admin-btn" style="max-width: 200px;">
      <i class="bi bi-plus-square"></i> Add Testimonial
    </button>
  </form>
</div>

<!-- Testimonials list table -->
<div class="data-box">
  <div class="data-box-header">
    <h3>Client Reviews</h3>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Avatar</th>
          <th>Client Name</th>
          <th>Company</th>
          <th>Message</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (testimonials.length > 0) { %>
          <% testimonials.forEach(t => { %>
            <tr>
              <td>
                <img src="<%= t.image %>" alt="<%= t.name %>" style="width: 35px; height: 35px; border-radius: 50%; object-fit: cover;" onerror="this.src='/images/avatar-placeholder.png'">
              </td>
              <td><strong><%= t.name %></strong></td>
              <td><span style="font-size: 0.85rem; color: var(--text-admin-secondary);"><%= t.company %></span></td>
              <td style="font-size: 0.85rem; color: var(--text-admin-secondary); max-width: 350px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= t.message %></td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 8px;">
                  <button class="admin-btn" style="padding: 6px 12px; background: var(--color-warning); font-size: 0.8rem;"
                    onclick="openEditTestimonialModal(<%- JSON.stringify(t) %>)">
                    <i class="bi bi-pencil-square"></i> Edit
                  </button>
                  
                  <form action="/admin/testimonials/delete/<%= t.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this testimonial?');">
                    <button type="submit" class="admin-btn" style="padding: 6px 12px; background: var(--color-danger); font-size: 0.8rem;">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-admin-muted); padding: 40px;">No client reviews added yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Edit Testimonial Modal -->
<div class="form-card" id="edit-testimonial-modal" style="display: none; position: fixed; top: 15%; left: 5%; right: 5%; width: 90%; z-index: 1000; box-shadow: 0 10px 50px rgba(0,0,0,0.8); border-color: var(--color-warning);">
  <div class="form-card-title" style="display: flex; justify-content: space-between; align-items: center;">
    <span><i class="bi bi-pencil-square"></i> Modify Client Testimonial</span>
    <button onclick="closeModal('edit-testimonial-modal')" class="admin-btn" style="max-width: 50px; background: var(--bg-admin-elevated); padding: 5px;"><i class="bi bi-x-lg"></i></button>
  </div>
  
  <form action="" method="POST" enctype="multipart/form-data">
    <div class="form-grid-2">
      <div class="admin-form-group">
        <label for="edit-name">Client Full Name *</label>
        <input type="text" id="edit-name" name="name" class="admin-input" required>
      </div>
      <div class="admin-form-group">
        <label for="edit-company">Company / Role</label>
        <input type="text" id="edit-company" name="company" class="admin-input">
      </div>
    </div>

    <div class="admin-form-group">
      <label for="edit-image">Replace Avatar Image (Leave blank to keep existing)</label>
      <input type="file" id="edit-image" name="image" class="admin-input" accept="image/*">
    </div>

    <div class="admin-form-group">
      <label for="edit-message">Testimonial Message *</label>
      <textarea id="edit-message" name="message" class="admin-input" required></textarea>
    </div>

    <div style="display: flex; gap: 15px;">
      <button type="submit" class="admin-btn" style="max-width: 200px; background: var(--color-warning);">
        <i class="bi bi-save"></i> Save Testimonial Changes
      </button>
      <button type="button" class="admin-btn" style="max-width: 150px; background: var(--bg-admin-elevated);" onclick="closeModal('edit-testimonial-modal')">
        Cancel
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
